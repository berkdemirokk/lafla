{
  "name": "lafla",
  "version": "0.1.0",
  "private": true,
  "description": "Söyle gitsin — Türk-first İngilizce konuşma simülatörü.",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "typecheck": "corepack pnpm --filter @lafla/mobile typecheck",
    "dev:mobile": "corepack pnpm --filter @lafla/mobile start",
    "test": "corepack pnpm --dir apps/mobile run test --runInBand"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.10.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@7.29.0": "7.29.7",
      "js-yaml@3.14.2": "3.15.0",
      "js-yaml@4.1.1": "4.3.0",
      "js-yaml@4.2.0": "4.3.0",
      "postcss": "8.5.10",
      "shell-quote": "1.9.0",
      "tar": "7.5.19",
      "brace-expansion@<1.1.16": "1.1.16",
      "brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
      "undici@6.25.0": "6.27.0",
      "uuid": "11.1.1",
      "ws@6.2.3": "6.2.4",
      "ws@7.5.10": "7.5.11",
      "ws@8.20.1": "8.21.0"
    }
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
