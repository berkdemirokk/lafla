{
  "expo": {
    "name": "Lafla",
    "slug": "lafla",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lafla",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": [
      "ios"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "bundleIdentifier": "com.lafla.app",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleLocalizations": [
          "tr",
          "en"
        ],
        "CFBundleDevelopmentRegion": "tr",
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Telaffuzunu değerlendirmek için mikrofona erişim gerekli.",
        "NSSpeechRecognitionUsageDescription": "Söylediğin İngilizce cümleleri anlamak için konuşma tanıma kullanılır.",
        "NSUserTrackingUsageDescription": "Sana daha iyi pratik önerileri sunmak için anonim kullanım verileri toplanır."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "supabaseUrl": "https://dljlqmzjfewevoxibdlh.supabase.co",
      "supabaseAnonKey": "sb_publishable_HoL3Tb8U0cQqm0wTf5zBxQ_IYipWD70",
      "eas": {
        "projectId": "a7b18723-d431-481b-92cd-18a4c1104171"
      }
    },
    "owner": "berkdemirok"
  }
}
