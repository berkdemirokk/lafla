{
  "expo": {
    "name": "Lafla",
    "slug": "lafla",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lafla",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": [
      "ios"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "bundleIdentifier": "com.lafla.app",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleLocalizations": [
          "tr",
          "en"
        ],
        "CFBundleDevelopmentRegion": "tr",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "supabaseUrl": "https://dljlqmzjfewevoxibdlh.supabase.co",
      "supabaseAnonKey": "sb_publishable_HoL3Tb8U0cQqm0wTf5zBxQ_IYipWD70",
      "eas": {
