# Lafla mobile env — copy to .env.local, fill values, DO NOT commit .env.local.
#
# These EXPO_PUBLIC_* values are read by app.config.ts at build time and
# baked into the binary. Anything not prefixed `EXPO_PUBLIC_` is not visible
# to the JS bundle.
#
# DEV / TestFlight builds: set these locally in `.env.local`.
# PRODUCTION (EAS Build → App Store): set them as EAS Secrets:
#     eas secret:create --scope project --name EXPO_PUBLIC_SENTRY_DSN --value '...'
#     eas secret:create --scope project --name EXPO_PUBLIC_POSTHOG_KEY --value '...'
# Then trigger production build:
#     eas build --platform ios --profile production
#
# Verify the binary actually carries them: open the .ipa, grep for the DSN
# substring in main.jsbundle, or check the Sentry dashboard for events from
# the TestFlight install.

# ─── Supabase (REQUIRED for auth, account delete, IAP attribution) ─
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ─── Sentry (REQUIRED for App Store submission) ─────────────────────
# Without this set, crash visibility is ZERO in production. The Privacy
# Nutrition Label declares Sentry; we must actually wire it.
# Get the DSN at: https://sentry.io → Project Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=https://YOUR-KEY@oXXXXXX.ingest.sentry.io/YYYYYYY

# ─── PostHog (REQUIRED if you keep "analytics" framing in the ATT prompt) ──
# Without this set, PostHog never initialises. The ATT prompt currently
# does not reference analytics (only ads + IDFA), so this is OPTIONAL for
# Apple Review. Set it only when you actually want product analytics.
# Get the key at: https://eu.posthog.com → Project Settings → Project API Key
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── TTS proxy (OPTIONAL; falls back to expo-speech) ────────────────
# Cloudflare Worker URL that proxies ElevenLabs. Empty = use bundled MP3s
# or Apple's native expo-speech engine (Siri voice).
EXPO_PUBLIC_TTS_ENDPOINT=

# ─── AdMob test override (DEV only) ─────────────────────────────────
# Force AdMob to serve test creatives even in a production-flavoured build.
# Used only by ads.ts when USE_TEST_ADS resolves to true. Leave blank for
# real ad serving in TestFlight + App Store builds.
EXPO_PUBLIC_USE_TEST_ADS=

# ─── RevenueCat fallback (OPTIONAL) ─────────────────────────────────
# app.json `extra.revenuecatIosKey` is the primary source; this env var
# overrides it for ad-hoc testing without rebuilding.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# ─── AI Serbest Sohbet / LLM Router (OPTIONAL) ──────────────────
# At least one key is needed for AI-powered free chat.
# Without any key, freechat falls back to static prompt responses.
# The router tries providers in order: Groq → Cerebras → Gemini → OpenRouter → Cloudflare
EXPO_PUBLIC_GROQ_KEY=
EXPO_PUBLIC_CEREBRAS_KEY=
EXPO_PUBLIC_GEMINI_KEY=
EXPO_PUBLIC_OPENROUTER_KEY=
EXPO_PUBLIC_CLOUDFLARE_KEY=
EXPO_PUBLIC_CLOUDFLARE_ACCOUNT=
