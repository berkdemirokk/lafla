{
  "name": "@lafla/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "asc:sync": "tsx scripts/asc-sync.ts",
    "asc:sync:apply": "tsx scripts/asc-sync.ts -- --apply"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@sentry/react-native": "^6.14.0",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "~53.0.27",
    "expo-apple-authentication": "~7.2.4",
    "expo-av": "~15.1.7",
    "expo-constants": "~17.1.8",
    "expo-file-system": "~18.1.11",
    "expo-font": "^56.0.5",
    "expo-haptics": "~14.1.4",
    "expo-linking": "~7.1.7",
    "expo-localization": "~16.1.6",
    "expo-notifications": "~0.31.5",
    "expo-print": "~14.1.4",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-sharing": "~13.1.5",
    "expo-speech": "~13.1.7",
    "expo-speech-recognition": "^1.1.1",
    "expo-splash-screen": "^56.0.10",
    "expo-status-bar": "~2.2.3",
    "expo-tracking-transparency": "~5.2.4",
    "posthog-react-native": "^3.10.0",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-google-mobile-ads": "15.8.3",
    "react-native-purchases": "^8.10.0",
    "react-native-reanimated": "~3.17.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-view-shot": "~4.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.0.14",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av",
          "@babel/runtime"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
